# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB — local (mongodb://localhost:27017) or a free MongoDB Atlas cluster
MONGO_URL=mongodb://localhost:27017
DB_NAME=vybe

# Comma-separated origins allowed to call the API. "*" is fine for local dev only.
CORS_ORIGINS=*

# ── Event sources: leave blank to skip a source ──────────────────────────────
# Free key: https://developer.ticketmaster.com  (5,000 calls/day)
TICKETMASTER_API_KEY=
# Free key on application: https://www.skiddle.com/api/
SKIDDLE_API_KEY=

# Claude + web search for grassroots events (pay-as-you-go, not a subscription)
# Key: https://platform.claude.com   Web search: $10 per 1,000 searches + tokens
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_SEARCHES_PER_CITY=8
CLAUDE_MONTHLY_SEARCH_BUDGET=600

# Pipeline
LOOKAHEAD_DAYS=30
# Required by the free OpenStreetMap geocoder's usage policy
CONTACT_EMAIL=
